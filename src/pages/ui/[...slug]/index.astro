---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { MDX_COMPONENT_REMAPPING } from "@/config/mdx-components";
import SandboxComponentLayout from "@/layouts/core/SandboxComponentLayout.astro";
import { filterContentForPage } from "@/utils/content";

export async function getStaticPaths() {
    const components = filterContentForPage(
        await getCollection("sandboxComponents"),
    );
    return components.map((component) => ({
        params: { slug: component.id },
        props: component,
    }));
}
type Props = CollectionEntry<"sandboxComponents">;
const component = Astro.props;

const { Content } = await render(component);
---

<SandboxComponentLayout data={component.data}>
    <Content components={MDX_COMPONENT_REMAPPING} />
</SandboxComponentLayout>
