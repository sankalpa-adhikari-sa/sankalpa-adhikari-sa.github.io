---
import PageLayout from "@/layouts/sandbox/PageLayout.astro";

export async function getStaticPaths() {
  const components =
    await import("../../../../components/gsap/components/index.ts");

  return Object.entries(components).map(([name, Component]) => {
    return {
      params: { component: name.toLowerCase() },
      props: { DynamicComponent: Component },
    };
  });
}

const { DynamicComponent } = Astro.props;
---

<PageLayout title="" description="">
  <DynamicComponent />
</PageLayout>
