---
import About from "@/components/core/About.astro";
import CompaniesShowcase from "@/components/core/CompaniesShowcase.astro";
import Footer from "@/components/core/Footer.astro";
import Hero from "@/components/core/Hero.astro";
import Services from "@/components/core/Services.astro";
import Spotlight from "@/components/core/Spotlight.astro";
import { getConfig } from "@/config/config";

import PageLayout from "@/layouts/core/PageLayout.astro";

const config = getConfig();
---

<PageLayout
  title="Sankalpa Adhikari"
  description={config.descriptions.site}
  dataPagefindIgnore="all"
>
  <Hero />
  <About />
  <Services />
  <Spotlight />
  <CompaniesShowcase />
  <Footer />
</PageLayout>
