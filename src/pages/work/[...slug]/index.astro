---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { MDX_COMPONENT_REMAPPING } from "@/config/mdx-components";
import BlogLayout from "@/layouts/core/BlogLayout.astro";
import { filterContentForPage } from "@/utils/content";

export async function getStaticPaths() {
  const posts = filterContentForPage(await getCollection("work"));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"work">;
const post = Astro.props;

const { Content, headings, remarkPluginFrontmatter } = await render(post);
const readingTime = remarkPluginFrontmatter.minutesRead;
---

<BlogLayout data={post.data} headings={headings} readingTime={readingTime}>
  <Content components={MDX_COMPONENT_REMAPPING} />
</BlogLayout>
