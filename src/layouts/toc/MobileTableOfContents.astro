---
import type { MarkdownHeading } from "astro";
import TableOfContentsList from "./TableOfContentsList.astro";
import { buildToc } from "./toc";

interface Props {
  headings: MarkdownHeading[];
  minHeadingLevel?: number;
  maxHeadingLevel?: number;
}

const { headings, minHeadingLevel = 1, maxHeadingLevel = 3 } = Astro.props;
const toc = buildToc(headings, {
  minLevel: minHeadingLevel,
  maxLevel: maxHeadingLevel,
});
---

{
  toc.length > 0 && (
    <mobile-toc-nav class="mobile-toc">
      <nav aria-labelledby="toc-mobile-heading">
        <details id="toc-mobile-details">
          <summary id="toc-mobile-heading">
            <span class="toggle">
              On this page
              <svg
                class="caret"
                viewBox="0 0 16 16"
                width="1rem"
                height="1rem"
                aria-hidden="true"
              >
                <path
                  d="M6 4l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="display-current" />
          </summary>
          <div class="dropdown">
            <TableOfContentsList toc={toc} isMobile />
          </div>
        </details>
      </nav>
    </mobile-toc-nav>
  )
}

<style>
  /* Hide on wide viewports where the desktop sidebar TOC takes over. */
  @media screen and (min-width: 1280px) {
    .mobile-toc {
      display: none;
    }
  }

  nav {
    position: fixed;
    z-index: 10;
    top: var(--header-height, 0px);
    inset-inline: 0;
    border-top: 1px solid
      var(
        --color-border,
        color-mix(in oklch, var(--color-foreground) 12%, transparent)
      );
    background-color: var(--color-background);
  }

  summary {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid
      var(
        --color-border,
        color-mix(in oklch, var(--color-foreground) 12%, transparent)
      );
    padding: var(--space-xs) var(--space-s);
    font-size: var(--font-size-sm);
    list-style: none;
    cursor: pointer;
  }

  summary::marker,
  summary::-webkit-details-marker {
    display: none;
  }

  .toggle {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-xs);
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--color-border);
    background-color: var(--color-secondary);
    border-radius: 0.5rem;
    padding-block: var(--space-2xs);
    padding-inline: var(--space-xs);
    line-height: 1;
    user-select: none;
    color: var(--color-foreground);
  }

  details[open] .toggle {
    border-color: var(--color-foreground);
    color: var(--color-foreground);
  }

  .caret {
    transition: transform var(--duration-fast) var(--ease-in-out);
  }

  details[open] .caret {
    transform: rotate(90deg);
  }

  :global([dir="rtl"]) .caret {
    transform: scaleX(-1);
  }

  :global([dir="rtl"]) details[open] .caret {
    transform: rotate(90deg) scaleX(-1);
  }

  .display-current {
    overflow: hidden;
    color: color-mix(
      in oklch,
      var(--color-secondary-foreground) 70%,
      transparent
    );
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dropdown {
    max-height: calc(70vh - var(--header-height, 0px));
    overflow-y: auto;
    border-top: 1px solid
      var(
        --color-border,
        color-mix(in oklch, var(--color-foreground) 12%, transparent)
      );
    background-color: var(--color-background);
    box-shadow: 0 0.5rem 1rem color-mix(in oklch, black 15%, transparent);
    overscroll-behavior: contain;
  }
</style>

<script>
  import { MobileTocTracker } from "./toc-tracker";

  if (!customElements.get("mobile-toc-nav")) {
    customElements.define("mobile-toc-nav", MobileTocTracker);
  }
</script>
