---
import Navbar from "./Navbar.astro";
import "./styles.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Hero from "../happily/components/sections/Hero.astro";
import { ButtonWave } from "./components/button";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-suisse" preload />
    <Font cssVariable="--font-sometype" preload />
    <title>Demo</title>
    <ClientRouter />
  </head>
  <body class="reset" data-color="light">
    <Navbar />
    <Hero />
    <ButtonWave
      theme="dark"
      style={{
        fontSize: "1.6rem",
        fontWeight: "500",
      }}
    >
      shop now
    </ButtonWave>
    <ButtonWave waveWidth="101%" disableTextAnim duration={0.6} theme="dark"
      >shop now</ButtonWave
    >
  </body>
</html>
