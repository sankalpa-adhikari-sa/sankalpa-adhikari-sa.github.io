---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> &
  HTMLAttributes<"button"> & {
    icon?: string;
    ariaLabel?: string;
    theme?: "auto" | "dark" | "light";
    wave?: "orange" | "purple" | "blueberry";
    border?: boolean;
  };

const {
  href,
  icon,
  ariaLabel,
  class: className,
  theme = "auto",
  wave = "orange",
  target,
  type = "button",
  border = false,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const rel = target === "_blank" ? "noopener noreferrer" : rest.rel;

const slotContent = await Astro.slots.render("default");
---

<Tag
  href={href}
  target={target}
  rel={rel}
  type={Tag === "button" ? type : undefined}
  aria-label={ariaLabel || rest["aria-label"]}
  class:list={[
    "button__wave-text",
    theme !== "auto" && `button--${theme}`,
    `button--wave-${wave}`,
    border && "button--has-border",
    className,
  ]}
  data-btn-animate
  {...rest}
>
  <span class="button__label">
    <span class="button__label__text"><slot /></span>
    <span
      class="button__label__text"
      aria-hidden="true"
      set:html={slotContent}
    />
  </span>
  {icon && <Icon class="button__icon" name={icon} aria-hidden="true" />}
</Tag>

<style>
  .button__wave-text {
    --button-bg: var(--dark);
    --button-text: var(--white);
    --button-hover-bg: var(--orange);
    --button-hover-text: var(--white);

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    font-weight: 700;
    color: var(--button-text);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8rem;
    overflow: hidden;
    padding: 1.2rem 2.4rem;
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    z-index: 1;
    transition:
      color 0.3s ease,
      border-color 0.1s ease;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    box-sizing: border-box;
  }

  .button__wave-text:hover,
  .button__wave-text:focus-visible {
    color: var(--button-hover-text);
  }

  /* Only apply border styles when border prop is true */
  .button__wave-text.button--has-border {
    border-color: var(--button-bg);
  }

  .button__wave-text.button--has-border:hover,
  .button__wave-text.button--has-border:focus-visible {
    border-color: var(--button-bg);
  }

  .button__wave-text:focus-visible {
    outline: 2px solid var(--button-hover-bg);
    outline-offset: 4px;
  }

  .button__wave-text:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global([data-color="dark"]) .button__wave-text:not(.button--light) {
    --button-bg: var(--dark);
    --button-text: var(--white);
  }

  :global([data-color="light"]) .button__wave-text:not(.button--dark) {
    --button-bg: var(--white);
    --button-text: var(--dark);
  }

  .button--dark {
    --button-bg: var(--dark);
    --button-text: var(--white);
  }

  .button--light {
    --button-bg: var(--white);
    --button-text: var(--dark);
  }

  .button--wave-orange {
    --button-hover-bg: var(--orange);
    --button-hover-text: var(--white);
  }

  .button--wave-purple {
    --button-hover-bg: var(--purple);
    --button-hover-text: var(--white);
  }

  .button--wave-blueberry {
    --button-hover-bg: var(--blueberry);
    --button-hover-text: var(--white);
  }

  .button__wave-text::before {
    background: var(--button-bg);
    content: "";
    display: block;
    height: 100%;
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    transition: 0.45s cubic-bezier(0.645, 0.045, 0.355, 1);
    width: 120%;
    z-index: -2;
  }

  .button__wave-text::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, 20%);
    transition: transform 0.45s cubic-bezier(0.645, 0.045, 0.355, 1);
    z-index: -1;
    will-change: transform;
    background: var(--button-hover-bg);
  }

  .button__wave-text:hover::after,
  .button__wave-text:focus-visible::after {
    transform: translate(-50%, -50%);
  }

  .button__label {
    position: relative;
    display: inline-flex;
    overflow: hidden;
    z-index: 2;
  }

  .button__label__text {
    display: inline-block;
    white-space: nowrap;
  }

  .button__label__text > * {
    display: inline-block !important;
  }

  .button__label__text:nth-child(2) {
    position: absolute;
    top: 0;
    left: 0;
  }

  .button__label__text div,
  .button__label__text span {
    display: inline-block !important;
    will-change: transform;
  }
  .button__icon {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }
  .button__label__text:nth-child(1) {
    color: var(--button-text);
  }

  .button__label__text:nth-child(2) {
    color: var(--button-hover-text);
  }
</style>

<script>
  import { gsap, SplitText, CustomEase } from "@/utils/gsap-init";

  let ctx: gsap.Context | undefined;
  let splitInstances: InstanceType<typeof SplitText>[] = [];

  async function initButtonWaveTextAnimation() {
    // Revert previous animations and restore original HTML DOM structure
    ctx?.revert();
    splitInstances.forEach((instance) => instance.revert());
    splitInstances = [];

    // Ensure custom fonts are loaded so SplitText measures dimensions accurately
    await document.fonts.ready;

    ctx = gsap.context(() => {
      CustomEase.create("waveEase", "0.645, 0.045, 0.355, 1");

      document
        .querySelectorAll<HTMLElement>("[data-btn-animate]")
        .forEach((button) => {
          const targets = button.querySelectorAll<HTMLElement>(
            ".button__label__text",
          );
          if (targets.length < 2) return;

          // Instantiate SplitText using 'new' and store instances for cleanup
          const splitTexts = Array.from(targets).map((text) => {
            const split = new SplitText(text, { type: "chars" });
            splitInstances.push(split);
            return split;
          });

          const tl = gsap.timeline({
            paused: true,
            defaults: {
              stagger: 0.02, // Added stagger for wave effect
              duration: 0.45,
              ease: "waveEase",
            },
          });

          gsap.set(splitTexts[1].chars, { y: "100%" });

          tl.to(splitTexts[0].chars, { y: "-105%" }).to(
            splitTexts[1].chars,
            { y: "0%" },
            "<",
          );

          button.addEventListener("mouseenter", () => tl.play());
          button.addEventListener("mouseleave", () => tl.reverse());

          button.addEventListener("focus", () => tl.play());
          button.addEventListener("blur", () => tl.reverse());
        });
    });
  }

  document.addEventListener("astro:page-load", initButtonWaveTextAnimation);
  document.addEventListener("astro:before-swap", () => {
    ctx?.revert();
    splitInstances.forEach((instance) => instance.revert());
  });
</script>
