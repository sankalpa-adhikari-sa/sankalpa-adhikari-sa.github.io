---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> &
  HTMLAttributes<"button"> & {
    icon?: string;
    ariaLabel?: string;
    theme?: "auto" | "dark" | "light";
    wave?: "orange" | "purple" | "blueberry";
    size?: "sm" | "md" | "lg";
  };

const {
  href,
  icon,
  ariaLabel,
  class: className,
  theme = "auto",
  wave = "orange",
  size = "md",
  target,
  type = "button",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const rel = target === "_blank" ? "noopener noreferrer" : rest.rel;
---

<Tag
  href={href}
  target={target}
  rel={rel}
  type={Tag === "button" ? type : undefined}
  aria-label={ariaLabel || rest["aria-label"]}
  class:list={[
    "button__wave",
    theme !== "auto" && `button--${theme}`,
    `button--wave-${wave}`,
    `button--${size}`,
    className,
  ]}
  {...rest}
>
  <span class="button__label">
    <slot />
  </span>

  {icon && <Icon class="button__icon" name={icon} aria-hidden="true" />}
</Tag>

<style>
  .button__wave {
    --button-bg: var(--dark);
    --button-text: var(--light);
    --button-hover-bg: var(--orange);
    --button-hover-text: var(--light);

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 28px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: inherit;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--button-text);
    background: transparent;
    border: none;
    border-radius: 999px;
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    z-index: 1;
    transition: color 0.3s ease;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }

  .button__wave:hover,
  .button__wave:focus-visible {
    color: var(--button-hover-text);
  }

  .button__wave:focus-visible {
    outline: 2px solid var(--button-hover-bg);
    outline-offset: 4px;
  }

  .button__wave:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global([data-color="dark"]) .button__wave:not(.button--light) {
    --button-bg: var(--dark);
    --button-text: var(--light);
  }

  :global([data-color="light"]) .button__wave:not(.button--dark) {
    --button-bg: var(--light);
    --button-text: var(--dark);
  }

  .button--dark {
    --button-bg: var(--dark);
    --button-text: var(--light);
  }

  .button--light {
    --button-bg: var(--light);
    --button-text: var(--dark);
  }

  .button--wave-orange {
    --button-hover-bg: var(--orange);
    --button-hover-text: var(--light);
  }

  .button--wave-purple {
    --button-hover-bg: var(--purple);
    --button-hover-text: var(--light);
  }

  .button--wave-blueberry {
    --button-hover-bg: var(--blueberry);
    --button-hover-text: var(--light);
  }

  .button--sm {
    padding: 10px 18px;
    font-size: 1.2rem;
  }

  .button--md {
    padding: 14px 28px;
    font-size: 1.4rem;
  }

  .button--lg {
    padding: 18px 36px;
    font-size: 1.6rem;
  }

  .button__wave::before {
    background: var(--button-bg);
    content: "";
    display: block;
    height: 100%;
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    transition: 0.6s cubic-bezier(0.645, 0.045, 0.355, 1);
    width: 120%;
    z-index: -2;
  }

  .button__wave::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, 20%);
    transition: transform 0.6s cubic-bezier(0.645, 0.045, 0.355, 1);
    z-index: -1;
    will-change: transform;
    background: var(--button-hover-bg);
  }

  .button__wave:hover::after,
  .button__wave:focus-visible::after {
    transform: translate(-50%, -50%);
  }

  .button__label,
  .button__icon {
    position: relative;
    z-index: 2;
  }

  .button__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
</style>
