<section class="my-5 flex why-units">
  <ul
    class="why-units-wrap flex flex-1 gap-[30px] overflow-hidden h-[clamp(750px,39.063vw,39.063vw)]"
  >
    <li data-event="click" class="flex flex-col gap-[30px] cursor-pointer">
      <div
        class="top-wrap flex flex-col rounded-[clamp(30px,2.604vw,2.604vw)] bg-yellow-700 px-[clamp(clamp(24px,0.938vw,18px),2.083vw,40px)] py-[35px]"
      >
        <div class="header-wrap flex items-center gap-3">
          <span
            class="number inline-flex h-8 w-8 items-center justify-center rounded-full border border-black p-5 text-2xl"
          >
            1
          </span>

          <span class="title text-2xl font-semibold">
            Practical ease and convenience, every day
          </span>
        </div>

        <div class="list-wrap h-0 overflow-hidden opacity-0">
          <ul class="flex flex-col pt-5">
            <li class="border-b border-black py-1 text-lg capitalize">
              All-inclusive rent - covering electricity, water, internet,
              heating/cooling and shared expenses.
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              Smooth check-in and check-out, with our team by your side.
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              Guided tours, in person or online.
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              We take care of your unit - fast support, whenever you need it.
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              Simple monthly payments, all done digitally.
            </li>
            <li
              class="border-b border-black py-1 text-lg capitalize last:border-b-0"
            >
              A two-month deposit secures your spot.
            </li>
          </ul>
        </div>
      </div>

      <div class="image-wrap grow overflow-hidden max-h-full min-h-0">
        <img
          width="2000"
          height="2999"
          src="https://units.gr/wp-content/uploads/2026/01/Yellow-Module-2.jpg"
          alt=""
          decoding="async"
          class="h-full w-full rounded-[clamp(30px,2.604vw,2.604vw)] object-cover"
        />
      </div>
    </li>

    <li data-event="click" class="flex flex-col gap-[30px] cursor-pointer">
      <div
        class="top-wrap flex flex-col rounded-[clamp(30px,2.604vw,2.604vw)] bg-green-700 px-[clamp(clamp(24px,0.938vw,18px),2.083vw,40px)] py-[35px]"
      >
        <div class="header-wrap flex items-center gap-3">
          <span
            class="number inline-flex h-8 w-8 items-center justify-center rounded-full border border-black p-5 text-2xl"
          >
            2
          </span>

          <span class="title text-2xl font-semibold">
            A new take on student living
          </span>
        </div>

        <div class="list-wrap h-0 overflow-hidden opacity-0">
          <ul class="flex flex-col pt-5">
            <li class="border-b border-black py-1 text-lg capitalize">
              Community-first approach
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              Seamless student living experience
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              Smart technology
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              Thoughtfully designed spaces
            </li>
            <li
              class="border-b border-black py-1 text-lg capitalize last:border-b-0"
            >
              Sustainable living
            </li>
          </ul>
        </div>
      </div>

      <div class="image-wrap grow overflow-hidden max-h-full min-h-0">
        <img
          width="2000"
          height="2999"
          src="https://units.gr/wp-content/uploads/2026/01/Green-Module-2.jpg"
          alt=""
          decoding="async"
          class="h-full w-full rounded-[clamp(30px,2.604vw,2.604vw)] object-cover"
        />
      </div>
    </li>

    <li data-event="click" class="flex flex-col gap-[30px] cursor-pointer">
      <div
        class="top-wrap flex flex-col rounded-[clamp(30px,2.604vw,2.604vw)] bg-blue-700 px-[clamp(clamp(24px,0.938vw,18px),2.083vw,40px)] py-[35px]"
      >
        <div class="header-wrap flex items-center gap-3">
          <span
            class="number inline-flex h-8 w-8 items-center justify-center rounded-full border border-black p-5 text-2xl"
          >
            3
          </span>

          <span class="title text-2xl font-semibold">
            Security and comfort from day one
          </span>
        </div>

        <div class="list-wrap h-0 overflow-hidden opacity-0">
          <ul class="flex flex-col pt-5">
            <li class="border-b border-black py-1 text-lg capitalize">
              24/7 Security
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
              24/7 Service
            </li>
            <li class="border-b border-black py-1 text-lg capitalize">
