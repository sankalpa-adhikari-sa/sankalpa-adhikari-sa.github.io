---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type BorderRadius = "none" | "xs" | "sm" | "md" | "lg";
type Theme = "auto" | "dark" | "light";
type Props = HTMLAttributes<"a"> &
  HTMLAttributes<"button"> & {
    iconName?: string;
    theme?: Theme;
    border?: boolean;
    borderRadius?: BorderRadius;
    href?: string;
  };
const {
  iconName,
  href,
  type = "button",
  target,
  borderRadius = "lg",
  ...rest
} = Astro.props;
const Tag = href ? "a" : "button";
const rel = target === "_blank" ? "noopener noreferrer" : rest.rel;

const radiusMap: Record<BorderRadius, string> = {
  none: "0rem",
  xs: "0.25rem",
  sm: "0.5rem",
  md: "1rem",
  lg: "2rem",
};

const currentRadius = radiusMap[borderRadius] || radiusMap.md;
---

<Tag
  data-btn-fip
  class="btn"
  href={href}
  target={target}
  rel={rel}
  style={`--border-radius: ${currentRadius};`}
  type={Tag === "button" ? type : undefined}
  {...rest}
>
  <span class="btn__label">
    <span class="btn__label-text"><slot /></span>
    <span aria-hidden="true" class="btn__label-text"><slot /></span>
  </span>
  {
    iconName && (
      <span class="btn__icon-wrapper" aria-hidden="true">
        <span class="btn__icon-inner">
          <Icon class="btn__icon" name={iconName} />
        </span>
        <span class="btn__icon-inner">
          <Icon class="btn__icon" name={iconName} />
        </span>
      </span>
    )
  }
</Tag>
<style define:vars={{ "border-radius": currentRadius }}>
  .btn {
    cursor: pointer;
    display: inline-flex;
    position: relative;
    flex-wrap: nowrap;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--foreground);
    text-decoration: none;
    outline-style: none;
    padding: 0;
    border-radius: var(--border-radius);
    overflow: hidden;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }

  .btn__label {
    display: grid;
    padding: 2px;
    box-sizing: border-box;
  }

  .btn__label-text {
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius);
    grid-column-start: 1;
    grid-row-start: 1;
  }

  .btn__label-text:nth-child(1) {
    background-color: transparent;
    color: var(--background);
  }

  .btn__label-text:nth-child(2) {
    background-color: var(--orange);
    color: white;
    transform: translateY(105%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn:hover .btn__label-text:nth-child(2) {
    transform: translateY(0);
  }

  .btn__icon-wrapper {
    display: grid;
    margin-right: 1rem;
  }
  .btn__icon-inner {
    grid-column-start: 1;
    grid-row-start: 1;
  }
  .btn__icon-inner:nth-child(1) {
    color: var(--orange);
  }
  .btn__icon-inner:nth-child(2) {
    color: var(--foreground);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover .btn__icon-inner:nth-child(2) {
    transform: translateY(0);
  }
</style>
