---
import { Image } from "astro:assets";
import heroImg from "../../assets/happly_gummies_hero.webp";
import { ButtonWave } from "../button";
---

<section class="section-hero">
  <div class="section-wrapper">
    <Image class={"hero-image"} src={heroImg} alt="Happly Gummies Hero" />
    <h1 class="hero-heading">the right amount of good</h1>
    <ButtonWave
      waveWidth="120%"
      style={{
        fontSize: "1.6rem",
        fontWeight: "500",
      }}
    >
      shop now
    </ButtonWave>
  </div>
</section>

<style>
  .section-hero {
    position: relative;
    display: flex;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    z-index: 1;
  }
  .hero-image {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    transform: translate(-50%, -50%);
  }
  .section-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: #fff;
    gap: 2.4rem;
    justify-content: end;
    width: 100vw;
    padding: 1.9rem;
  }

  .hero-heading {
    font-family: var(--font-sans);
    font-weight: 500 !important;
    font-size: 4.8rem;
    letter-spacing: -0.144rem;
    line-height: 4.512rem;
    max-width: 78.9rem;
    white-space: pre-line;
    z-index: -1;
    padding: 0px !important;
  }

  @media (min-width: 576px) {
    .hero-heading {
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 9.2rem;
      letter-spacing: -0.368rem;
      max-width: 78.9rem;
      line-height: 7.912rem;
      padding: 4rem;
    }
    .section-wrapper {
      align-items: flex-end;
      color: #fff;
      display: flex;
      flex-direction: row;
      gap: 2.4rem;
      justify-content: space-between;
      width: 100vw;
      padding: 1.9rem;
    }
  }
</style>
