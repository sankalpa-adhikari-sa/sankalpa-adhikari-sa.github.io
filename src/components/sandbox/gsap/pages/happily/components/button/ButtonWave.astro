---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> &
    HTMLAttributes<"button"> & {
        icon?: string;
        ariaLabel?: string;
        theme?: "auto" | "dark" | "light";
        wave?: "orange" | "purple" | "blueberry";
        border?: boolean;
        stagger?: number;
        duration?: number;
        disableTextAnim?: boolean;
        waveWidth?: string;
    };

const {
    href,
    icon,
    ariaLabel,
    class: className,
    theme = "auto",
    wave = "orange",
    target,
    type = "button",
    border = false,
    stagger = 0.02,
    duration = 0.45,
    disableTextAnim = false,
    waveWidth = "120%",
    ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const rel = target === "_blank" ? "noopener noreferrer" : rest.rel;
const slotContent = await Astro.slots.render("default");
---

<anm-button-wave
    data-stagger={stagger}
    data-duration={duration}
    data-disable-text-anim={String(disableTextAnim)}
>
    <Tag
        href={href}
        target={target}
        rel={rel}
        type={Tag === "button" ? type : undefined}
        aria-label={ariaLabel || rest["aria-label"]}
        class:list={[
            "button__wave-text",
            theme !== "auto" && `button--${theme}`,
            `button--wave-${wave}`,
            border && "button--has-border",
            disableTextAnim && "button--no-text-anim",
            className,
        ]}
        {...rest}
    >
        <span class="button__label">
            <span class="button__label__text"><slot /></span>
            {
                !disableTextAnim && (
                    <span
                        class="button__label__text"
                        aria-hidden="true"
                        set:html={slotContent}
                    />
                )
            }
        </span>
        {icon && <Icon class="button__icon" name={icon} aria-hidden="true" />}
    </Tag>
</anm-button-wave>

<style
    define:vars={{ "wave-duration": `${duration}s`, "wave-width": waveWidth }}
>
    anm-button-wave {
        display: inline-block;
    }

    .button__wave-text {
        --button-bg: var(--dark);
        --button-text: var(--white);
        --button-hover-bg: var(--orange);
        --button-hover-text: var(--white);

        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        text-decoration: none;
        font-weight: 700;
        color: var(--button-text);
        background: transparent;
        border: 1px solid transparent;
        border-radius: 8rem;
        overflow: hidden;
        padding: 1.2rem 2.4rem;
        isolation: isolate;
        cursor: pointer;
        z-index: 1;
        transition:
            color 0.3s ease,
            border-color 0.1s ease;
        -webkit-mask-image: -webkit-radial-gradient(white, black);
        box-sizing: border-box;
    }

    .button__wave-text:hover,
    .button__wave-text:focus-visible {
        color: var(--button-hover-text);
    }

    .button__wave-text.button--has-border {
        border-color: var(--button-bg);
    }

    .button__wave-text.button--has-border:hover,
    .button__wave-text.button--has-border:focus-visible {
        border-color: var(--button-bg);
    }

    .button__wave-text:focus-visible {
        outline: 2px solid var(--button-hover-bg);
        outline-offset: 4px;
    }

    .button__wave-text:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    :global([data-color="dark"]) .button__wave-text:not(.button--light) {
        --button-bg: var(--dark);
        --button-text: var(--white);
    }

    :global([data-color="light"]) .button__wave-text:not(.button--dark) {
        --button-bg: var(--white);
        --button-text: var(--dark);
    }

    .button--dark {
        --button-bg: var(--dark);
        --button-text: var(--white);
    }

    .button--light {
        --button-bg: var(--white);
        --button-text: var(--dark);
    }

    .button--wave-orange {
        --button-hover-bg: var(--orange);
        --button-hover-text: var(--white);
    }

    .button--wave-purple {
        --button-hover-bg: var(--purple);
        --button-hover-text: var(--white);
    }

    .button--wave-blueberry {
        --button-hover-bg: var(--blueberry);
        --button-hover-text: var(--white);
    }

    .button__wave-text::before {
        background: var(--button-bg);
        content: "";
        display: block;
        height: 100%;
        left: 50%;
        position: absolute;
        top: 0;
        transform: translateX(-50%);
        transition: var(--wave-duration) cubic-bezier(0.645, 0.045, 0.355, 1);
        width: 120%;
        z-index: -2;
    }

    .button__wave-text::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--wave-width);
        height: auto;
        aspect-ratio: 1;
        border-radius: 50%;
        transform: translate(-50%, 20%);
        transition: transform var(--wave-duration)
            cubic-bezier(0.645, 0.045, 0.355, 1);
        z-index: -1;
        will-change: transform;
        background: var(--button-hover-bg);
    }

    .button__wave-text:hover::after,
    .button__wave-text:focus-visible::after {
        transform: translate(-50%, -50%);
    }

    .button__label {
        position: relative;
        display: inline-flex;
        overflow: hidden;
        z-index: 2;
    }

    .button__label__text {
        display: inline-block;
        white-space: nowrap;
    }

    .button__label__text > * {
        display: inline-block !important;
    }

    .button__label__text:nth-child(2) {
        position: absolute;
        top: 0;
        left: 0;
    }

    .button__label__text div,
    .button__label__text span {
        display: inline-block !important;
        will-change: transform;
    }

    .button__icon {
        width: 1.6rem;
        height: 1.6rem;
        flex-shrink: 0;
    }

    .button__label__text:nth-child(1) {
        color: var(--button-text);
        transition: color 0.3s ease;
    }

    .button__label__text:nth-child(2) {
        color: var(--button-hover-text);
    }

    .button--no-text-anim:hover .button__label__text:nth-child(1),
    .button--no-text-anim:focus-visible .button__label__text:nth-child(1) {
        color: var(--button-hover-text);
    }
</style>

<script>
    import { gsap, SplitText, CustomEase } from "@/utils/gsap-init";

    class AnmButtonWave extends HTMLElement {
        private ctx: gsap.Context | null = null;
        private splitInstances: InstanceType<typeof SplitText>[] = [];
        private tl: gsap.core.Timeline | null = null;
        private buttonTarget: HTMLElement | null = null;

        private stagger: number;
        private duration: number;

        constructor() {
            super();
            this.stagger = parseFloat(this.dataset.stagger || "0.02");
            this.duration = parseFloat(this.dataset.duration || "0.45");

            this.handlePlay = this.handlePlay.bind(this);
            this.handleReverse = this.handleReverse.bind(this);
        }

        async connectedCallback() {
            if (this.dataset.disableTextAnim === "true") return;

            this.buttonTarget =
                this.querySelector<HTMLElement>(".button__wave-text");
            const targets = this.querySelectorAll<HTMLElement>(
                ".button__label__text",
            );

            if (!this.buttonTarget || targets.length < 2) return;

            if (!gsap.parseEase("waveEase")) {
                CustomEase.create("waveEase", "0.645, 0.045, 0.355, 1");
            }

            await document.fonts.ready;

            if (!this.isConnected) return;

            this.ctx = gsap.context(() => {
                this.splitInstances = Array.from(targets).map(
                    (text) => new SplitText(text, { type: "chars" }),
                );

                this.tl = gsap.timeline({
                    paused: true,
                    defaults: {
                        stagger: this.stagger,
                        duration: this.duration,
                        ease: "waveEase",
                    },
                });

                if (this.splitInstances[1]?.chars) {
                    gsap.set(this.splitInstances[1].chars, { y: "100%" });

                    this.tl
                        .to(this.splitInstances[0].chars, { y: "-105%" })
                        .to(this.splitInstances[1].chars, { y: "0%" }, "<");
                }
            }, this);

            this.buttonTarget.addEventListener("mouseenter", this.handlePlay);
            this.buttonTarget.addEventListener("focus", this.handlePlay);
            this.buttonTarget.addEventListener(
                "mouseleave",
                this.handleReverse,
            );
            this.buttonTarget.addEventListener("blur", this.handleReverse);
        }

        disconnectedCallback() {
            if (this.buttonTarget) {
                this.buttonTarget.removeEventListener(
                    "mouseenter",
                    this.handlePlay,
                );
                this.buttonTarget.removeEventListener("focus", this.handlePlay);
                this.buttonTarget.removeEventListener(
                    "mouseleave",
                    this.handleReverse,
                );
                this.buttonTarget.removeEventListener(
                    "blur",
                    this.handleReverse,
                );
            }

            this.ctx?.revert();
            this.splitInstances.forEach((instance) => instance.revert());
            this.splitInstances = [];
            this.tl?.kill();
        }

        private handlePlay() {
            if (this.tl) this.tl.play();
        }

        private handleReverse() {
            if (this.tl) this.tl.reverse();
        }
    }

    if (!customElements.get("anm-button-wave")) {
        customElements.define("anm-button-wave", AnmButtonWave);
    }
</script>
