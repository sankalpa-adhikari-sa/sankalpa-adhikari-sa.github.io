---
import { Icon } from "astro-icon/components";
import { getConfig } from "@/config/config";
import ThemeToggle from "./ThemeToggle.astro";

const menuLinks = [
  { name: "Home", href: "/" },
  { name: "Articles", href: "/articles" },
  { name: "Projects", href: "/projects" },
  { name: "Work", href: "/work" },
];

const config = getConfig();
---

<section
  id="contact"
  data-pointer-tracking
  class="relative isolate flex h-screen flex-col overflow-hidden bg-background px-6 pb-8 pt-34 md:px-10"
>
  <div
    class="relative z-10 flex flex-1 flex-col items-center justify-center text-center"
  >
    <h2
      class="text-[clamp(3.25rem,12vw,11.25rem)] font-light leading-[0.95] tracking-tighter text-foreground"
    >
      <span class="let-text block will-change-transform">Let's</span>
      <span class="collab-text block will-change-transform text-primary"
        >Collaborate!</span
      >
    </h2>
  </div>

  <footer class="relative z-10 mt-24 w-full">
    <div
      class="grid grid-cols-2 gap-10 border-t border-border/60 pt-12 md:grid-cols-[1fr_1fr_1.4fr]"
    >
      <div>
        <p
          class="mb-5 font-mono text-xs uppercase tracking-[0.25em] text-muted-foreground"
        >
          Menu
        </p>
        <ul class="space-y-3 text-lg text-foreground/80 md:text-xl">
          {
            menuLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-footer-link
                  class="inline-flex origin-left transition-transform duration-300 ease-out hover:scale-110 hover:text-foreground"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p
          class="mb-5 font-mono text-xs uppercase tracking-[0.25em] text-muted-foreground"
        >
          Connect
        </p>
        <ul class="space-y-3 text-lg text-foreground/80 md:text-xl">
          {
            config.socialProfiles
              .filter((profile) => profile.showInFooter)
              .map((profile) => (
                <li>
                  <a
                    href={
                      profile.url.startsWith("http")
                        ? profile.url
                        : `https://${profile.url}`
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    data-footer-link
                    class="group inline-flex origin-left items-center gap-1.5 transition-transform duration-300 ease-out hover:scale-110 hover:text-foreground"
                  >
                    {profile.name}
                    <Icon
                      name="heroicons:arrow-up-right-16-solid"
                      class="h-4 w-4 opacity-70 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:opacity-100"
                    />
                  </a>
                </li>
              ))
          }
        </ul>
      </div>

      <div>
        <p
          class="mb-5 font-mono text-xs uppercase tracking-[0.25em] text-muted-foreground"
        >
          Say hello
        </p>
        <a
          href={`mailto:${config.author.contactEmail}?subject=Let's%20Work%20Together&body=I%20came%20across%20your%20portfolio%20and%20would%20love%20to%20discuss%20a%20potential%20project%2C%20collaboration%2C%20or%20opportunity.Here%20are%20a%20few%20details%3A%E2%80%A2%20Project%20%2F%20Company%3A%E2%80%A2%20Project%20overview%3A%E2%80%A2%20Timeline%3A%E2%80%A2%20Budget%20(optional)%3A%E2%80%A2%20Website%20or%20reference%20links%3A%E2%80%A2%20Additional%20details%3ALooking%20forward%20to%20hearing%20from%20you!Best%2C%5BYour%20Name%5D`}
          data-footer-link
          class="inline-block origin-left font-mono text-[clamp(1.125rem,2.5vw,2.125rem)] leading-[1.1] tracking-tight text-foreground transition-transform duration-300 ease-out hover:scale-105 hover:text-primary"
        >
          {config.author.email}
        </a>
        <div class="mt-6 flex items-center gap-3">
          <span class="relative flex h-2.5 w-2.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75 dark:bg-green-500"
            ></span>
            <span
              class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500 dark:bg-green-400"
            ></span>
          </span>
          <span class="font-mono text-sm text-muted-foreground"
            >Available for work — {config.author.location} / Remote</span
          >
        </div>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-4 border-t border-border/60 pt-6 md:flex-row md:items-center md:justify-between"
    >
      <ThemeToggle />
      <button
        onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
        data-footer-link
        class="group inline-flex origin-right items-center gap-1 font-mono text-sm uppercase tracking-[0.2em] text-muted-foreground transition-transform duration-300 ease-out hover:scale-105 hover:text-foreground"
      >
        Back to top
        <Icon
          name="heroicons:arrow-up-16-solid"
          class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-1"
        />
      </button>
    </div>
  </footer>
</section>

<script>
  import { gsap } from "@/utils/gsap-init";
  import { audio } from "@/utils/audio";

  let ctx: gsap.Context | undefined;

  function initFooterAnimation() {
    ctx?.revert();
    ctx = gsap.context(() => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#contact",
          start: "top bottom",
          end: "center center",
          scrub: 1,
        },
      });

      tl.from(
        ".let-text",
        {
          x: "-50vw",
          opacity: 0,
          ease: "none",
        },
        0,
      );

      tl.from(
        ".collab-text",
        {
          x: "50vw",
          opacity: 0,
          ease: "none",
        },
        0,
      );

      const footerLinks = document.querySelectorAll("[data-footer-link]");

      const onLinkHover = () => {
        audio.play("pop");
      };

      footerLinks.forEach((link) => {
        link.addEventListener("mouseenter", onLinkHover);
      });

      return () => {
        footerLinks.forEach((link) => {
          link.removeEventListener("mouseenter", onLinkHover);
        });
      };
    });
  }

  document.addEventListener("astro:page-load", initFooterAnimation);
  document.addEventListener("astro:before-swap", () => ctx?.revert());
</script>
