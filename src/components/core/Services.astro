---
const services = [
  {
    title: "Full-Stack Web Apps",
    description:
      "React and Next.js interfaces wired to FastAPI, Express, or Django backends - design, built, and ship end-to-end.",
    stack: ["React", "Next.js", "FastAPI", "Django", "Postgres"],
  },
  {
    title: "Backend & API Architecture",
    description:
      "Payment integrations, protocol implementations, and async task systems built to hold up under real traffic.",
    stack: [
      "Express",
      "Fastfiy",
      "FastAPI",
      "RabbitMQ",
      "Celery",
      "Stripe",
      "Razorpay",
    ],
  },
  {
    title: "AI Agent & Workflow Automation",
    description:
      "Browser-automation agents and AI pipelines that handle discovery, checkout, and repetitive ops work on their own.",
    stack: ["LangGraph", "Playwright", "Claude", "Redis"],
  },
  {
    title: "Data Tools & Dashboards",
    description:
      "Messy spreadsheets and field data turned into pipelines and dashboards that non-technical teams actually use.",
    stack: [
      "Python",
      "Pandas",
      "Power BI",
      "Streamlit",
      "Refine",
      "Kobotoolbox",
      "Openfn",
      "Airflow",
    ],
  },
];
---

<section
  id="services-section"
  data-nav-section-message="Services"
  class="relative w-full pb-24 md:pb-32 bg-background"
>
  <div>
    <div data-service-item class="max-w-xl opacity-0 translate-y-8">
      <span
        class="font-mono text-xs uppercase tracking-[0.25em] text-muted-foreground"
      >
        Services
      </span>
      <h2
        class="mt-4 text-3xl md:text-4xl font-bold text-foreground tracking-tight text-balance"
      >
        Where I can help
      </h2>
      <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
        Four kinds of work I take on most often. Most projects mix two or three
        of these.
      </p>
    </div>

    <div class="mt-12 grid lg:grid-cols-2">
      {
        services.map((service) => (
          <div
            data-service-item
            class="group relative p-6 transition-colors hover:bg-tertiary border opacity-0 translate-y-8"
          >
            <span class="absolute left-0 top-0 h-6 w-6 border-l-3 border-t-3  border-tertiary-foreground opacity-0 transition-opacity duration-200 group-hover:opacity-100" />

            <span class="absolute right-0 top-0 h-6 w-6 border-r-3 border-t-3 border-tertiary-foreground opacity-0 transition-opacity duration-200 group-hover:opacity-100" />

            <span class="absolute bottom-0 left-0 h-6 w-6 border-b-3 border-l-3 border-tertiary-foreground opacity-0 transition-opacity duration-200 group-hover:opacity-100" />

            <span class="absolute bottom-0 right-0 h-6 w-6 border-b-3 border-r-3 border-tertiary-foreground opacity-0 transition-opacity duration-200 group-hover:opacity-100" />

            <h3 class="text-xl font-semibold group-hover:text-tertiary-foreground">
              {service.title}
            </h3>

            <p class="mt-2 text-muted-foreground leading-relaxed group-hover:text-tertiary-foreground/80">
              {service.description}
            </p>

            <ul class="mt-4 flex flex-wrap gap-2">
              {service.stack.map((tech) => (
                <li class="rounded-full border border-tertiary-foreground px-2.5 py-1 font-mono text-[11px] uppercase tracking-wide text-muted-foreground group-hover:text-tertiary-foreground/80">
                  {tech}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "@/utils/gsap-init";

  let ctx: gsap.Context | undefined;

  function initServicesAnimation() {
    ctx?.revert();

    const section = document.getElementById("services-section");
    if (!section) return;

    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    ctx = gsap.context(() => {
      const items = document.querySelectorAll<HTMLElement>(
        "[data-service-item]",
      );

      if (reducedMotionQuery.matches) {
        gsap.set(items, { opacity: 1, y: 0 });
        return;
      }

      gsap
        .timeline({
          scrollTrigger: {
            trigger: section,
            start: "top 75%",
          },
        })
        .to(items, {
          y: 0,
          opacity: 1,
          duration: 0.7,
          ease: "power3.out",
          stagger: 0.15,
        });
    });
  }

  document.addEventListener("astro:page-load", initServicesAnimation);
  document.addEventListener("astro:before-swap", () => ctx?.revert());
</script>
